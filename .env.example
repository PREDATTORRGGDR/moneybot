# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111

# Сколько GRAM отправляешь и цена в Stars
GRAM_AMOUNT=0.1
PRICE_STARS=100

# Оплата GRAM (TON). Оставь PRICE_TON пустым, чтобы отключить
PRICE_TON=0.2
TON_WALLET=UQ...твой_адрес
# Ключ toncenter.com (необязательно, без него лимит 1 запрос/сек)
TONCENTER_API_KEY=

# Оплата переводом на карту: покупатель присылает PDF-чек, админ подтверждает кнопкой.
# Оставь PRICE_RUB или CARD_NUMBER пустым, чтобы отключить
PRICE_RUB=
CARD_NUMBER=
CARD_BANK=
CARD_HOLDER=

# Поддержка: username без @, можно несколько через запятую (у каждого своя кнопка)
SUPPORT_USERNAME=your_support

# Админы (ID через запятую), которым НЕ слать алерт о новом пользователе. Покупки приходят всем
NEW_USER_ALERTS_OFF=

# Канал с отзывами: кнопка «Отзывы» в меню сразу открывает его
REVIEWS_URL=https://t.me/your_reviews
# ID или @username канала, куда бот публикует отзывы (бот должен быть админом).
# Пусто = отзывы приходят админам в личку
REVIEWS_CHAT_ID=@your_reviews
